<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Aplicativo.Mobile.MainPage" Title="Login">
    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="18" VerticalOptions="Center">
            <Label Text="LogTrack" Style="{StaticResource Headline}" HorizontalOptions="Center" />
            <Label Text="Entre para acessar o aplicativo" Style="{StaticResource SubHeadline}" HorizontalOptions="Center" />
            <Button x:Name="GoogleLoginButton" Text="Continuar com Google" Clicked="OnGoogleLoginClicked" HorizontalOptions="Fill" />
            <Label x:Name="StatusLabel" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
            <Button x:Name="LogoutButton" Text="Sair" IsVisible="False" Clicked="OnLogoutClicked" HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
